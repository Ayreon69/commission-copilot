    },
    "/api/samples/{perimeter}/contracts/{contract_id}": {
      "get": {
        "tags": [
          "calcul"
        ],
        "summary": "Get Sample Contract",
        "operationId": "get_sample_contract_api_samples__perimeter__contracts__contract_id__get",
        "parameters": [
          {
            "name": "perimeter",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Perimeter"
            }
          },
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Contract Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleContractOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Chat",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "429": {
            "description": "Limite de débit de la démo atteinte (en-tête Retry-After) ou quota du fournisseur de modèle épuisé"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Chat Stream",
        "operationId": "chat_stream_api_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Flux Server-Sent Events. Événements, dans l'ordre où ils surviennent :\n\n- `delta` `{\"text\"}` : texte généré. Le texte qui précède des appels d'outils n'est pas la réponse finale.\n- `tool_call` `{\"name\", \"arguments\"}` : un outil va être exécuté.\n- `tool_result` : trace de l'appel (même format que `tool_calls` de `/api/chat`).\n- `done` : réponse complète, au même format que `/api/chat`.\n- `error` `{\"status\", \"detail\"}` : échec du modèle (429 quota épuisé, 502 indisponible) ; le flux s'arrête.\n",
            "content": {
              "text/event-stream": {}
            }
          },
          "429": {
            "description": "Limite de débit de la démo atteinte (en-tête Retry-After) ou quota du fournisseur de modèle épuisé"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
