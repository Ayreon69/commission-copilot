# Copier ce fichier en .env à la racine du dépôt (le fichier .env n'est jamais commité).

# Clé API Mistral : sans elle, l'API démarre mais l'assistant (/api/chat) est désactivé.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Origines autorisées à appeler l'API depuis un navigateur (interface Next.js), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000
