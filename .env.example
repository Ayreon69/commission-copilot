# Copier ce fichier en .env à la racine du dépôt (le fichier .env n'est jamais commité).

# Clé API du fournisseur de modèle. Par défaut : Google Gemini, clé gratuite sans carte bancaire
# sur https://aistudio.google.com. Sans clé, l'API démarre mais l'assistant (/api/chat) est désactivé.
LLM_API_KEY=

# Tout fournisseur compatible avec l'API OpenAI fonctionne. Exemples :
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/   (défaut)
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Modèles essayés dans l'ordre : quand le quota gratuit de l'un est épuisé, le suivant prend le relais.
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash

# Niveau de raisonnement (low, medium, high). Laisser vide pour la valeur par défaut du modèle.
LLM_REASONING_EFFORT=

# Origines autorisées à appeler l'API depuis un navigateur (interface Next.js), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000
